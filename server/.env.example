# Smart Math Calculator - AI backend configuration template (Part 4A)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` (git-ignored) or export the variables in your
# shell, then start the server with an env file:
#
#   node --env-file=server/.env.local server/server.js
#
# NEVER put a real key in this file, in .env.example, in README.md or in any
# frontend file. Only `.env.local` (or your hosting provider's secret store)
# holds the real value.

# --- server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8787

# --- provider ---------------------------------------------------------------
# none    -> the AI fallback stays honestly unavailable (HTTP 503). Default.
# generic -> chat-style JSON POST to AI_PROVIDER_URL using AI_PROVIDER_API_KEY.
# gemini  -> Google Gemini generateContent REST using AI_PROVIDER_API_KEY
#            (x-goog-api-key header); the endpoint is derived from
#            AI_PROVIDER_MODEL, so AI_PROVIDER_URL is optional.
#            Gemini is then the PRIMARY and OpenRouter the BACKUP.
# openrouter -> OpenRouter Chat Completions using OPENROUTER_API_KEY and
#            OPENROUTER_MODEL; the endpoint is OPENROUTER_URL. OpenRouter is
#            then the PRIMARY and Gemini the BACKUP.
AI_PROVIDER=none

# The ONLY secret. Keep it server-side; leave it empty in this template.
AI_PROVIDER_API_KEY=

# Provider endpoint that accepts a chat-style JSON POST (set when AI_PROVIDER=generic).
# With AI_PROVIDER=gemini an explicit URL still wins, but normally leave this
# empty: the server POSTs to
# https://generativelanguage.googleapis.com/v1beta/models/<model>:generateContent
AI_PROVIDER_URL=

# Model name. With AI_PROVIDER=gemini this selects the Gemini model
# (default: gemini-3.8-flash); with AI_PROVIDER=generic it is sent in the body.
AI_PROVIDER_MODEL=gemini-3.8-flash

# Outbound auth header for the provider request (generic only;
# defaults: Authorization / Bearer). Gemini always uses x-goog-api-key.
AI_PROVIDER_AUTH_HEADER=Authorization
AI_PROVIDER_AUTH_SCHEME=Bearer

# Where the model text sits in the provider's JSON response (generic only).
# Default matches chat-completions style payloads; numeric segments are indexes.
# Gemini always reads candidates.0.content.parts.0.text.
AI_PROVIDER_RESPONSE_PATH=choices.0.message.content

# Extra body fields for a specific provider, as a JSON object (optional).
# Applied first; the model and the mathematics prompt always win.
AI_PROVIDER_EXTRA_JSON=

# --- limits -----------------------------------------------------------------
# 'full' mode asks the model for a complete beginner lesson, which takes
# longer to generate than a one-line answer. Clamped to 1000..60000.
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_QUESTION_LENGTH=2000

# --- browser access ---------------------------------------------------------
# Empty = same-origin only (recommended). Set to your app origin during local
# development if the page is served from a different origin/port.
AI_ALLOWED_ORIGIN=

# --- username feature (Part 5) ----------------------------------------------
# POST /api/username stores ONE username, sent by the browser only when it is
# online. It is saved in server/data/usernames.json (git-ignored) and holds
# nothing else: no email, phone, password, date of birth, location, IP, device
# id, browser info, calculator history, solver history or AI conversation.

# Where that file lives. Leave empty for the default server/data/usernames.json.
USERNAMES_FILE=

# ADMIN_TOKEN unlocks the admin-only list (GET /api/admin/usernames) and nothing
# else. It is read from the server environment ONLY - never put it in the
# frontend, and never commit a real value. While it is EMPTY the route answers
# 404, so the list is unreachable by default rather than protected by a guessable
# default. On the machine that owns the data file you can also read the list with:
#   node server/admin-usernames.js
ADMIN_TOKEN=

# --- OpenRouter (PRIMARY with AI_PROVIDER=openrouter, otherwise BACKUP) -------
# With AI_PROVIDER=openrouter OpenRouter answers first; when it fails with a
# recoverable provider failure (rate limit, quota, timeout, temporary upstream
# error, bad auth or a malformed reply) the server tries Gemini EXACTLY ONCE as
# backup, with the same prompt, then returns the answer through the normal
# {answer, steps} contract.
# With AI_PROVIDER=gemini the order is reversed: Gemini first, OpenRouter as the
# single backup. If the backup fails too, the existing safe AI-unavailable
# behaviour applies. Leave the missing provider's key empty to disable the chain.
# The OpenRouter secret. Keep it server-side; leave it empty in this template.
OPENROUTER_API_KEY=
# OpenRouter model: a currently available ":free" model
# (default: qwen/qwen3.8-27b:free).
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
